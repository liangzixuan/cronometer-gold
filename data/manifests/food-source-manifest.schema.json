{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutrition.local/schemas/food-source-manifest.schema.json",
  "title": "Nutrition Tracker food-source release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "templateOnly",
    "releaseClass",
    "evidenceBundle",
    "source",
    "release",
    "artifact",
    "rights",
    "ingestion",
    "validation"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": { "const": 4 },
    "templateOnly": { "type": "boolean" },
    "releaseClass": { "enum": ["live-reviewed", "fixture-nonrelease"] },
    "evidenceBundle": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractVersion", "sha256", "objectUri"],
          "properties": {
            "contractVersion": { "const": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "objectUri": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^s3://(?![0-9]+(?:\\.[0-9]+){3}/)(?![a-z0-9.-]*\\.\\.)[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]/(?:[A-Za-z0-9_-][A-Za-z0-9._~-]*/)*sha256/[0-9a-f]{64}(?:/[A-Za-z0-9_-][A-Za-z0-9._~-]*)*$"
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "displayName", "kind", "homepageUrl", "accessUrl"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$" },
        "displayName": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["commercial", "government", "open", "partner"] },
        "homepageUrl": { "type": "string", "format": "uri" },
        "accessUrl": { "type": "string", "format": "uri" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseKey", "publishedOn", "acquiredAt", "upstreamSchemaVersion"],
      "properties": {
        "releaseKey": { "type": "string", "minLength": 1 },
        "publishedOn": { "type": ["string", "null"], "format": "date" },
        "acquiredAt": { "type": ["string", "null"], "format": "date-time" },
        "upstreamSchemaVersion": { "type": ["string", "null"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "downloadUrl",
        "permittedResolvedUrls",
        "objectUri",
        "mediaType",
        "sha256",
        "byteSize",
        "publisherIntegrity"
      ],
      "properties": {
        "downloadUrl": { "type": ["string", "null"], "format": "uri" },
        "permittedResolvedUrls": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "objectUri": { "type": ["string", "null"], "pattern": "^s3://" },
        "mediaType": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "byteSize": { "type": ["integer", "null"], "minimum": 1 },
        "publisherIntegrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publisherProvidesSha256",
            "sha256",
            "sha256EvidenceUrl",
            "exactByteSize",
            "reportedSize",
            "metadataUrl",
            "notes"
          ],
          "properties": {
            "publisherProvidesSha256": { "type": "boolean" },
            "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "sha256EvidenceUrl": { "type": ["string", "null"], "format": "uri" },
            "exactByteSize": { "type": ["integer", "null"], "minimum": 1 },
            "reportedSize": { "type": ["string", "null"] },
            "metadataUrl": { "type": "string", "format": "uri" },
            "notes": { "type": "string" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "publisherProvidesSha256": { "const": true } },
                "required": ["publisherProvidesSha256"]
              },
              "then": {
                "properties": {
                  "sha256": { "type": "string" },
                  "sha256EvidenceUrl": { "type": "string" }
                }
              },
              "else": {
                "properties": {
                  "sha256": { "type": "null" },
                  "sha256EvidenceUrl": { "type": "null" }
                }
              }
            }
          ]
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "licenseExpression",
        "licenseName",
        "licenseUrl",
        "termsUrl",
        "commercialUseAllowed",
        "redistributionAllowed",
        "licenseAttributionRequired",
        "productAttributionRequired",
        "attributionFixture",
        "databaseRightsNotes",
        "review"
      ],
      "properties": {
        "licenseExpression": { "type": "string", "minLength": 1 },
        "licenseName": { "type": "string", "minLength": 1 },
        "licenseUrl": { "type": "string", "format": "uri" },
        "termsUrl": { "type": "string", "format": "uri" },
        "commercialUseAllowed": { "type": ["boolean", "null"] },
        "redistributionAllowed": { "type": ["boolean", "null"] },
        "licenseAttributionRequired": { "type": "boolean" },
        "productAttributionRequired": { "type": "boolean" },
        "attributionFixture": { "type": "string", "minLength": 1 },
        "databaseRightsNotes": { "type": "string" },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewedAt", "reviewedBy", "evidenceUrls", "notes"],
          "properties": {
            "status": { "enum": ["approved", "blocked", "pending", "restricted", "template"] },
            "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
            "reviewedBy": { "type": ["string", "null"] },
            "evidenceUrls": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "format": "uri" }
            },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "ingestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parserPackage",
        "parserVersion",
        "parserBuildSha256",
        "dataTypes",
        "languages",
        "markets",
        "sourceIdentityFields",
        "missingValuePolicy"
      ],
      "properties": {
        "parserPackage": { "type": "string", "minLength": 1 },
        "parserVersion": { "type": ["string", "null"] },
        "parserBuildSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "dataTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "markets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9]{2,3}$" }
        },
        "sourceIdentityFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "missingValuePolicy": { "const": "absent-is-unknown-never-zero" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "expectedFiles", "releaseSpecificExpectations"],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "releaseSpecificExpectations": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [{ "type": "boolean" }, { "type": "number" }, { "type": "string" }]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "templateOnly": { "const": false } },
        "required": ["templateOnly"]
      },
      "then": {
        "type": "object",
        "properties": {
          "evidenceBundle": { "type": "object" },
          "release": {
            "type": "object",
            "properties": {
              "acquiredAt": { "type": "string" },
              "upstreamSchemaVersion": { "type": "string", "minLength": 1 }
            }
          },
          "artifact": {
            "type": "object",
            "properties": {
              "downloadUrl": { "type": "string", "pattern": "^https://" },
              "objectUri": { "type": "string" },
              "sha256": { "type": "string" },
              "byteSize": { "type": "integer" }
            }
          },
          "ingestion": {
            "type": "object",
            "properties": {
              "parserVersion": { "type": "string", "minLength": 1 },
              "parserBuildSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "validation": {
            "type": "object",
            "properties": {
              "expectedFiles": { "type": "array", "minItems": 1 },
              "releaseSpecificExpectations": { "type": "object", "minProperties": 1 }
            }
          },
          "rights": {
            "type": "object",
            "properties": {
              "commercialUseAllowed": { "const": true },
              "review": {
                "type": "object",
                "properties": {
                  "status": { "enum": ["approved", "restricted"] },
                  "reviewedAt": { "type": "string" },
                  "reviewedBy": {
                    "type": "string",
                    "minLength": 3,
                    "pattern": "^(?!\\s)(?:.*\\S)?$"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "evidenceBundle": { "type": "null" }
        }
      }
    }
  ]
}
