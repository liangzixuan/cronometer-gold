[Unit]
Description=Restrict controlled-beta object clients to OCI Object Storage HTTPS
Requires=docker.service firewalld.service
After=docker.service firewalld.service network-online.target
PartOf=docker.service firewalld.service
Before=nutrition-tracker.service
OnFailure=nutrition-release-failure-containment.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nutrition-object-egress-firewall-watchdog
SuccessExitStatus=3
TimeoutStartSec=15min
TimeoutStopSec=2min
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
