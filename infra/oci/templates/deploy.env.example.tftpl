# Non-secret deployment coordinates. On the host, copy this installed example
# to /etc/nutrition-tracker/deploy.env and replace every marker. Never stage a
# checkout-local deploy.env.
API_FQDN=${api_fqdn}
WEB_FQDN=${web_fqdn}
ACME_EMAIL=REPLACE_RELEASE_OPERATOR_EMAIL
# Space-separated public reviewer egress CIDRs. Prefer one /32 per reviewer.
# Only GET /ready also permits private bridge/VCN source addresses.
BETA_ALLOWED_CIDRS=REPLACE_PUBLIC_REVIEWER_CIDRS

# Every runtime, including the patched Meilisearch derivative, must use the
# repository-owned image for one exact release commit.
MEILI_IMAGE=ghcr.io/liangzixuan/cronometer-gold-meilisearch@sha256:REPLACE_MEILISEARCH_64_HEX_DIGEST
# All seven repository images must be digest-qualified linux/arm64 results from
# the same reviewed SERVICE_VERSION workflow run. Replace only each marker with
# its 64 lowercase hexadecimal digest; local image IDs are not valid evidence.
CADDY_IMAGE=ghcr.io/liangzixuan/cronometer-gold-caddy@sha256:REPLACE_CADDY_64_HEX_DIGEST
POSTGRES_IMAGE=ghcr.io/liangzixuan/cronometer-gold-postgres@sha256:REPLACE_POSTGRES_64_HEX_DIGEST
API_IMAGE=ghcr.io/liangzixuan/cronometer-gold-api@sha256:REPLACE_API_64_HEX_DIGEST
WEB_IMAGE=ghcr.io/liangzixuan/cronometer-gold-web@sha256:REPLACE_WEB_64_HEX_DIGEST
WORKER_IMAGE=ghcr.io/liangzixuan/cronometer-gold-worker@sha256:REPLACE_WORKER_64_HEX_DIGEST
MIGRATOR_IMAGE=ghcr.io/liangzixuan/cronometer-gold-migrator@sha256:REPLACE_MIGRATOR_64_HEX_DIGEST
