# Production-mode application controls for the synthetic-data controlled beta.
NODE_ENV=production
OCI_PILOT_DATA_CLASSIFICATION=synthetic-reviewer-only
LOG_LEVEL=info
SERVICE_VERSION=REPLACE_GIT_COMMIT_SHA
DATABASE_SSL_MODE=verify-full
DATABASE_APPLICATION_NAME=cronometer-gold-beta
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=120000
MEILI_URL=https://meili.internal:8443
EXPORT_ARTIFACT_STORE=s3
EXPORT_ARTIFACT_ENDPOINT=${object_s3_endpoint}
EXPORT_ARTIFACT_REGION=${region}
EXPORT_ARTIFACT_BUCKET=${export_bucket_name}
EXPORT_ARTIFACT_DELETE_VERSION_POLICY=latest
EXPORT_ARTIFACT_CURRENT_KEY_ID=REPLACE_EXPORT_KEY_ID
EXPORT_ARTIFACT_READ_SPOOL_DIR=/var/lib/nutrition-tracker/export-read-spool
EXPORT_ARTIFACT_READ_SPOOL_PROTECTION=encrypted_volume
EXPORT_ARTIFACT_READ_MAX_ARTIFACT_BYTES=10737418240
EXPORT_ARTIFACT_READ_MAX_CONCURRENCY=2
EXPORT_ARTIFACT_READ_MAX_RESERVED_BYTES=21474836480
EXPORT_ARTIFACT_READ_MAX_BYTES_PER_WINDOW=21474836480
ERASURE_REPLAY_LEDGER_STORE=s3
ERASURE_REPLAY_LEDGER_ENDPOINT=${object_s3_endpoint}
ERASURE_REPLAY_LEDGER_REGION=${region}
ERASURE_REPLAY_LEDGER_BUCKET=${ledger_bucket_name}
ERASURE_REPLAY_LEDGER_CURRENT_KEY_ID=REPLACE_ERASURE_KEY_ID
ERASURE_REPLAY_LEDGER_LOCATOR_CURRENT_KEY_ID=REPLACE_LOCATOR_KEY_ID
RETENTION_FEATURES_ENABLED=true
RETENTION_EXPORT_SPOOL_DIR=/var/lib/nutrition-tracker/export-spool
RETENTION_EXPORT_SPOOL_PROTECTION=encrypted_volume
RETENTION_EXPORT_SPOOL_MAX_BYTES=10737418240
SEARCH_REBUILD_SPOOL_DIR=/var/lib/nutrition-tracker/search-spool
SEARCH_REBUILD_SPOOL_MAX_BYTES=2147483648
SEARCH_REBUILD_WORKER_ID=beta-food-search-worker
RETENTION_WORKER_ID=beta-retention-worker
