{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucketVersions"],
      "Resource": ["arn:aws:s3:::nutrition-erasure-ledger"],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["erasure-ledger/v1/*"]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": ["arn:aws:s3:::nutrition-erasure-ledger/erasure-ledger/v1/*"]
    }
  ]
}
