# Install as /etc/nutrition-tracker/deploy.env with root:root mode 0600.
SYNTHETIC_ONLY_ACKNOWLEDGEMENT=REPLACE_EXACT_SYNTHETIC_ONLY_ACKNOWLEDGEMENT
# This literal is an intentional stop condition, not an acknowledgement an
# operator may override. See files/README.md.
AZURE_OCI_EGRESS_ADMISSION=BLOCKED_NOT_IMPLEMENTED
AZURE_OCI_CREDENTIAL_INSTALL_ADMISSION=BLOCKED_NOT_IMPLEMENTED
AZURE_OCI_USAGE_ADMISSION=BLOCKED_NOT_IMPLEMENTED
AZURE_OFF_HOST_BACKUP_ADMISSION=BLOCKED_NOT_IMPLEMENTED
API_FQDN=api.nourishing.app
WEB_FQDN=app.nourishing.app
ACME_EMAIL=REPLACE_RELEASE_OPERATOR_EMAIL
BETA_ALLOWED_CIDRS=REPLACE_SINGLE_PUBLIC_REVIEWER_IPV4_SLASH_32

# Every image is immutable. The preflight also inspects the pulled image and
# rejects anything other than linux/arm64. It never pulls an image itself.
MEILI_IMAGE=ghcr.io/liangzixuan/cronometer-gold-meilisearch@sha256:REPLACE_MEILISEARCH_64_HEX_DIGEST
CADDY_IMAGE=ghcr.io/liangzixuan/cronometer-gold-caddy@sha256:REPLACE_CADDY_64_HEX_DIGEST
POSTGRES_IMAGE=ghcr.io/liangzixuan/cronometer-gold-postgres@sha256:REPLACE_POSTGRES_64_HEX_DIGEST
API_IMAGE=ghcr.io/liangzixuan/cronometer-gold-api@sha256:REPLACE_API_64_HEX_DIGEST
WEB_IMAGE=ghcr.io/liangzixuan/cronometer-gold-web@sha256:REPLACE_WEB_64_HEX_DIGEST
WORKER_IMAGE=ghcr.io/liangzixuan/cronometer-gold-worker@sha256:REPLACE_WORKER_64_HEX_DIGEST
MIGRATOR_IMAGE=ghcr.io/liangzixuan/cronometer-gold-migrator@sha256:REPLACE_MIGRATOR_64_HEX_DIGEST
