# Offline restore principal only. Never pass this file to API or worker.
ERASURE_REPLAY_LEDGER_ENCRYPTION_KEYS=REPLACE_CANONICAL_LEDGER_KEYRING_JSON
ERASURE_REPLAY_LEDGER_LOCATOR_HMAC_KEYS=REPLACE_CANONICAL_LOCATOR_KEYRING_JSON
ERASURE_REPLAY_LEDGER_RESTORE_ACCESS_KEY_ID=REPLACE_OCI_LEDGER_RESTORE_ACCESS_KEY_ID
ERASURE_REPLAY_LEDGER_RESTORE_SECRET_ACCESS_KEY=REPLACE_OCI_LEDGER_RESTORE_SECRET_ACCESS_KEY
ERASURE_REPLAY_LEDGER_RESTORE_SPOOL_DIR=/var/lib/nutrition-tracker/erasure-restore-spool
ERASURE_REPLAY_LEDGER_RESTORE_SPOOL_PROTECTION=tmpfs
ERASURE_REPLAY_LEDGER_RESTORE_VERSION_LIST_PROVIDER=oci_native
ERASURE_REPLAY_LEDGER_RESTORE_REQUEST_TIMEOUT_MS=30000
ERASURE_REPLAY_LEDGER_RESTORE_MAX_CONCURRENCY=4
ERASURE_REPLAY_LEDGER_RESTORE_OCI_KEY_FINGERPRINT=REPLACE_OCI_LEDGER_RESTORE_KEY_FINGERPRINT
ERASURE_REPLAY_LEDGER_RESTORE_OCI_NAMESPACE=REPLACE_OCI_NAMESPACE
ERASURE_REPLAY_LEDGER_RESTORE_OCI_PRIVATE_KEY_FILE=/run/oci/restore-private-key.pem
ERASURE_REPLAY_LEDGER_RESTORE_OCI_TENANCY_OCID=REPLACE_OCI_TENANCY_OCID
ERASURE_REPLAY_LEDGER_RESTORE_OCI_USER_OCID=REPLACE_OCI_RESTORE_USER_OCID
