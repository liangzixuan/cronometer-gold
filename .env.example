# Local development only. Copy to .env; never reuse these values outside a laptop.
NODE_ENV=development
LOG_LEVEL=debug
API_HOST=127.0.0.1
API_PORT=4000
READINESS_TIMEOUT_MS=2000
SHUTDOWN_GRACE_MS=10000
POLL_INTERVAL_MS=1000
API_INTERNAL_URL=http://127.0.0.1:4000
# Production must set the browser-facing credential-free HTTPS origin.
# WEB_PUBLIC_ORIGIN=https://nutrition.example.com
# Leave EXPO_PUBLIC_API_URL unset for platform-aware local emulator defaults.
# Release builds require an explicit non-loopback HTTPS origin via the release preflight.

# PostgreSQL
POSTGRES_DB=nutrition_tracker
POSTGRES_USER=nutrition_local
POSTGRES_PASSWORD=nutrition_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nutrition_local:nutrition_local_only@127.0.0.1:5432/nutrition_tracker
DATABASE_APPLICATION_NAME=nutrition-tracker-local
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=120000
# Keep TLS options out of DATABASE_URL; production sets this to verify-full.
DATABASE_SSL_MODE=disable
# Production API and worker deployments require a fresh 32+ character epoch.
# The offline erasure-ledger replay command attests it before either runtime starts.
# DATABASE_RESTORE_EPOCH=replace-with-a-unique-value-for-each-database-restore
# Optional absolute path; normally discovered from packages/db/migrations.
# DB_MIGRATIONS_DIR=

# Meilisearch CE — derived search projection, never nutritional source of truth.
MEILI_PORT=7700
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=local-meili-key-not-for-production
# Use scoped search/admin keys outside local development. The local master key is
# intentionally reused only inside this loopback-only Compose environment.
MEILI_SEARCH_KEY=local-meili-key-not-for-production
MEILI_ADMIN_KEY=local-meili-key-not-for-production
MEILI_ENV=development
SEARCH_CURSOR_SECRET=local-search-cursor-secret-change-before-shared-use-32-bytes
SEARCH_DB_MAX_CONCURRENCY=4
SEARCH_DB_MAX_QUEUE=16
SEARCH_REQUEST_TIMEOUT_MS=5000
SEARCH_TASK_TIMEOUT_MS=120000
SEARCH_REBUILD_BATCH_SIZE=500
SEARCH_REBUILD_EVENT_BATCH_SIZE=100
SEARCH_REBUILD_WORKER_ID=local-food-search-worker
# Production should point this at an encrypted ephemeral volume.
# SEARCH_REBUILD_SPOOL_DIR=/var/run/nutrition-tracker/search-spool
SEARCH_REBUILD_SPOOL_MAX_BYTES=2147483648
SEARCH_REBUILD_SPOOL_MAX_DOCUMENTS=5000000

# Retention workers and encrypted private artifacts. These deterministic values
# are local-only fixtures; production must use independently generated keys,
# separate least-privilege object-store credentials, and HTTPS endpoints.
RETENTION_FEATURES_ENABLED=true
RETENTION_WORKER_ID=local-retention-worker
# Production should point this at an encrypted ephemeral volume.
# RETENTION_EXPORT_SPOOL_DIR=/var/run/nutrition-tracker/export-spool
# Production must declare either tmpfs or encrypted_volume after verifying the mount.
# RETENTION_EXPORT_SPOOL_PROTECTION=encrypted_volume
RETENTION_EXPORT_SPOOL_MAX_AGE_MS=3600000
RETENTION_EXPORT_SPOOL_MAX_BYTES=10737418240
EXPORT_ARTIFACT_STORE=filesystem
# Local MinIO uses a versioning-suspended bucket. The OCI controlled beta must set latest.
EXPORT_ARTIFACT_DELETE_VERSION_POLICY=suspended_null
EXPORT_ARTIFACT_DIRECTORY=/tmp/nutrition-tracker-encrypted-exports
EXPORT_ARTIFACT_CURRENT_KEY_ID=local-export-key-v1
EXPORT_ARTIFACT_ENCRYPTION_KEYS={"local-export-key-v1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="}
EXPORT_ARTIFACT_REQUEST_TIMEOUT_MS=30000
EXPORT_ARTIFACT_ENDPOINT=http://127.0.0.1:9000
EXPORT_ARTIFACT_REGION=us-east-1
EXPORT_ARTIFACT_BUCKET=nutrition-private-exports
EXPORT_ARTIFACT_WRITE_ACCESS_KEY_ID=nutrition_export_writer
EXPORT_ARTIFACT_WRITE_SECRET_ACCESS_KEY=nutrition_export_writer_local_only
EXPORT_ARTIFACT_READ_ACCESS_KEY_ID=nutrition_export_reader
EXPORT_ARTIFACT_READ_SECRET_ACCESS_KEY=nutrition_export_reader_local_only
# Production should point this at an encrypted ephemeral volume.
# EXPORT_ARTIFACT_READ_SPOOL_DIR=/var/run/nutrition-tracker/export-read-spool
# Production must declare either tmpfs or encrypted_volume after verifying the mount.
# EXPORT_ARTIFACT_READ_SPOOL_PROTECTION=encrypted_volume
EXPORT_ARTIFACT_READ_SPOOL_MAX_AGE_MS=3600000
EXPORT_ARTIFACT_READ_MAX_ARTIFACT_BYTES=10737418240
EXPORT_ARTIFACT_READ_MAX_RESERVED_BYTES=21474836480
EXPORT_ARTIFACT_READ_MAX_CONCURRENCY=2
EXPORT_ARTIFACT_READ_RATE_WINDOW_MS=3600000
EXPORT_ARTIFACT_READ_MAX_DOWNLOADS_PER_WINDOW=3
EXPORT_ARTIFACT_READ_MAX_BYTES_PER_WINDOW=21474836480
ERASURE_REPLAY_LEDGER_ENDPOINT=http://127.0.0.1:9000
ERASURE_REPLAY_LEDGER_REGION=us-east-1
ERASURE_REPLAY_LEDGER_BUCKET=nutrition-erasure-ledger
ERASURE_REPLAY_LEDGER_STORE=filesystem
ERASURE_REPLAY_LEDGER_DIRECTORY=/tmp/nutrition-tracker-encrypted-erasure-ledger
ERASURE_REPLAY_LEDGER_CURRENT_KEY_ID=local-erasure-ledger-key-v1
ERASURE_REPLAY_LEDGER_ENCRYPTION_KEYS={"local-erasure-ledger-key-v1":"AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI="}
ERASURE_REPLAY_LEDGER_LOCATOR_CURRENT_KEY_ID=local-erasure-locator-key-v1
ERASURE_REPLAY_LEDGER_LOCATOR_HMAC_KEYS={"local-erasure-locator-key-v1":"AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM="}
# API-only, short-lived status recovery key; retain it through the maximum erasure capability window.
ERASURE_STATUS_CAPABILITY_HMAC_KEY=BAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ=
# API-only deterministic challenge replay key; generate independently in production.
DEVICE_CHALLENGE_HMAC_KEY=BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQU=
ERASURE_REPLAY_LEDGER_WRITE_ACCESS_KEY_ID=nutrition_erasure_writer
ERASURE_REPLAY_LEDGER_WRITE_SECRET_ACCESS_KEY=nutrition_erasure_writer_local_only
# Restore tooling only. Do not pass these read credentials to API or worker runtimes.
ERASURE_REPLAY_LEDGER_RESTORE_ACCESS_KEY_ID=nutrition_erasure_restore
ERASURE_REPLAY_LEDGER_RESTORE_SECRET_ACCESS_KEY=nutrition_erasure_restore_local_only
# Local integration only. The OCI controlled-beta restore must set this to oci_native.
ERASURE_REPLAY_LEDGER_RESTORE_VERSION_LIST_PROVIDER=s3_compatible
# With oci_native, ERASURE_REPLAY_LEDGER_ENDPOINT must be exactly
# https://<namespace>.compat.objectstorage.<region>.oci.customer-oci.com[/]
# OCI native ListObjectVersions credentials are restore-only. The key path must be
# absolute and point to an owner/root-owned regular file with mode 0400 or 0600.
# ERASURE_REPLAY_LEDGER_RESTORE_OCI_NAMESPACE=exampletenancynamespace
# ERASURE_REPLAY_LEDGER_RESTORE_OCI_TENANCY_OCID=ocid1.tenancy.oc1..example
# ERASURE_REPLAY_LEDGER_RESTORE_OCI_USER_OCID=ocid1.user.oc1..example
# ERASURE_REPLAY_LEDGER_RESTORE_OCI_KEY_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
# ERASURE_REPLAY_LEDGER_RESTORE_OCI_PRIVATE_KEY_FILE=/run/secrets/oci_restore_api_key.pem
# Offline restore tooling only. Production must use a verified protected mount.
ERASURE_REPLAY_LEDGER_RESTORE_SPOOL_DIR=/tmp/nutrition-tracker-erasure-restore-spool
# ERASURE_REPLAY_LEDGER_RESTORE_SPOOL_PROTECTION=encrypted_volume
ERASURE_REPLAY_LEDGER_RESTORE_SPOOL_MAX_AGE_MS=3600000
ERASURE_REPLAY_LEDGER_RESTORE_REQUEST_TIMEOUT_MS=30000
ERASURE_REPLAY_LEDGER_RESTORE_MAX_CONCURRENCY=4

# MinIO / S3-compatible object storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=nutrition_local
MINIO_ROOT_PASSWORD=nutrition_local_password_only
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=nutrition-local
S3_ACCESS_KEY_ID=nutrition_local
S3_SECRET_ACCESS_KEY=nutrition_local_password_only
S3_FORCE_PATH_STYLE=true

# Mailpit catches all local email; it does not relay externally.
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Nutrition Tracker Local <no-reply@nutrition.local>

# Replace with a generated high-entropy value in every non-local environment.
AUTH_SECRET=local-auth-secret-change-before-shared-use
SESSION_COOKIE_SECURE=false
