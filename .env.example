# Local development only. Copy to .env; never reuse these values outside a laptop.
NODE_ENV=development
LOG_LEVEL=debug
API_HOST=127.0.0.1
API_PORT=4000
READINESS_TIMEOUT_MS=2000
SHUTDOWN_GRACE_MS=10000
POLL_INTERVAL_MS=1000
API_INTERNAL_URL=http://127.0.0.1:4000
# Production must set the browser-facing credential-free HTTPS origin.
# WEB_PUBLIC_ORIGIN=https://nutrition.example.com
# Leave EXPO_PUBLIC_API_URL unset for platform-aware local emulator defaults.
# Release builds require an explicit non-loopback HTTPS origin via the release preflight.

# PostgreSQL
POSTGRES_DB=nutrition_tracker
POSTGRES_USER=nutrition_local
POSTGRES_PASSWORD=nutrition_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nutrition_local:nutrition_local_only@127.0.0.1:5432/nutrition_tracker
DATABASE_APPLICATION_NAME=nutrition-tracker-local
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=120000
# Keep TLS options out of DATABASE_URL; production sets this to verify-full.
DATABASE_SSL_MODE=disable
# Optional absolute path; normally discovered from packages/db/migrations.
# DB_MIGRATIONS_DIR=

# Meilisearch CE — derived search projection, never nutritional source of truth.
MEILI_PORT=7700
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=local-meili-key-not-for-production
# Use scoped search/admin keys outside local development. The local master key is
# intentionally reused only inside this loopback-only Compose environment.
MEILI_SEARCH_KEY=local-meili-key-not-for-production
MEILI_ADMIN_KEY=local-meili-key-not-for-production
MEILI_ENV=development
SEARCH_CURSOR_SECRET=local-search-cursor-secret-change-before-shared-use-32-bytes
SEARCH_DB_MAX_CONCURRENCY=4
SEARCH_DB_MAX_QUEUE=16
SEARCH_REQUEST_TIMEOUT_MS=5000
SEARCH_TASK_TIMEOUT_MS=120000
SEARCH_REBUILD_BATCH_SIZE=500
SEARCH_REBUILD_EVENT_BATCH_SIZE=100
SEARCH_REBUILD_WORKER_ID=local-food-search-worker
# Production should point this at an encrypted ephemeral volume.
# SEARCH_REBUILD_SPOOL_DIR=/var/run/nutrition-tracker/search-spool
SEARCH_REBUILD_SPOOL_MAX_BYTES=2147483648
SEARCH_REBUILD_SPOOL_MAX_DOCUMENTS=5000000

# MinIO / S3-compatible object storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=nutrition_local
MINIO_ROOT_PASSWORD=nutrition_local_password_only
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=nutrition-local
S3_ACCESS_KEY_ID=nutrition_local
S3_SECRET_ACCESS_KEY=nutrition_local_password_only
S3_FORCE_PATH_STYLE=true

# Mailpit catches all local email; it does not relay externally.
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Nutrition Tracker Local <no-reply@nutrition.local>

# Replace with a generated high-entropy value in every non-local environment.
AUTH_SECRET=local-auth-secret-change-before-shared-use
SESSION_COOKIE_SECURE=false
