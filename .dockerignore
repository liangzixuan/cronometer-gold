!packages/search/**

# The source-built Node runtime is the only image that copies a repository infra file.
!infra/
infra/*
!infra/docker/
infra/docker/*
!infra/docker/node-release-CC68F5A3106FF448322E48ED27F5E38D5B0A215F.asc

