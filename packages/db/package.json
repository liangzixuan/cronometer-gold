{
  "name": "@nutrition-tracker/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kysely access, PostgreSQL schema types, and forward-only migrations",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx src/cli.ts",
    "db:migrate:prod": "node dist/cli.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nutrition-tracker/domain": "workspace:*",
    "dotenv": "17.4.2",
    "kysely": "0.29.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
