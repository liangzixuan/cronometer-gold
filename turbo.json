{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "@nutrition-tracker/api#dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "interruptible": true,
      "passThroughEnv": [
        "API_HOST",
        "API_PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "READINESS_TIMEOUT_MS",
        "SERVICE_VERSION",
        "SHUTDOWN_GRACE_MS"
      ],
      "persistent": true,
      "with": ["@nutrition-tracker/contracts#dev"]
    },
    "@nutrition-tracker/worker#dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "interruptible": true,
      "passThroughEnv": [
        "LOG_LEVEL",
        "NODE_ENV",
        "POLL_INTERVAL_MS",
        "SERVICE_VERSION",
        "SHUTDOWN_GRACE_MS"
      ],
      "persistent": true,
      "with": ["@nutrition-tracker/contracts#dev"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
