{
  "name": "@nutrition-tracker/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "build": "node scripts/run-expo.mjs export --platform all --output-dir dist",
    "build:release": "pnpm release:check && node scripts/run-expo.mjs export --platform all --output-dir dist",
    "ci:release-state": "node scripts/check-ci-release-state.mjs",
    "config:check": "node scripts/check-native-config.mjs && node scripts/check-eas-config.mjs",
    "dependencies:check": "node scripts/run-expo.mjs install --check",
    "dev": "node scripts/run-expo.mjs start",
    "eas-build-post-install": "pnpm release:check",
    "eas:check": "node scripts/check-eas-config.mjs",
    "lint": "biome lint App.tsx src",
    "release:check": "node scripts/check-eas-config.mjs --release && node scripts/check-release-env.mjs && node scripts/check-native-config.mjs",
    "release:health-evidence": "node scripts/check-health-release.mjs",
    "start": "node scripts/run-expo.mjs start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kingstinct/react-native-healthkit": "14.0.2",
    "@nutrition-tracker/contracts": "workspace:*",
    "@react-navigation/native": "7.3.16",
    "@react-navigation/native-stack": "7.18.8",
    "@sbaiahmed1/react-native-biometrics": "0.16.0",
    "expo": "57.0.14",
    "expo-build-properties": "57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "57.0.4",
    "expo-notifications": "57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-health-connect": "4.1.3",
    "react-native-nitro-modules": "0.36.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
