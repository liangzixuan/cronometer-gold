{
  "expo": {
    "name": "Nutrition Tracker",
    "slug": "nutrition-tracker",
    "owner": "zixuanliang",
    "version": "0.1.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutritionledger.app",
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSHealthShareUsageDescription": "Allow Nutrition Tracker to import weight after you choose to connect Apple Health."
      }
    },
    "android": {
      "allowBackup": false,
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.nutritionledger.app"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "minSdkVersion": 26,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Allow Nutrition Tracker to import weight after you choose to connect Apple Health.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      "./plugins/with-local-notifications-only.js",
      [
        "expo-notifications",
        {
          "defaultChannel": "private-reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": false
        }
      ]
    ],
    "extra": {
      "productBoundary": "consumer-wellness",
      "nativeHealth": {
        "androidReadRecordTypes": ["Weight"],
        "deviceSigningKeyAlias": "nutrition-tracker-health-import-v1",
        "lockScreenNotificationBody": "Time to check in.",
        "lockScreenNotificationTitle": "Nutrition Tracker",
        "signedBatchProtocol": "nutrition-tracker-health-import-v1"
      },
      "eas": {
        "projectId": "14022636-ab56-468c-94f6-d6106addde42"
      }
    }
  }
}
