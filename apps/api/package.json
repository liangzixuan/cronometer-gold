{
  "name": "@nutrition-tracker/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/polling-tsx-watch.mjs --include ../../packages/artifact-store/dist/**/*.js --include ../../packages/contracts/dist/**/*.js --include ../../packages/db/dist/**/*.js --include ../../packages/domain/dist/**/*.js --include ../../packages/search/dist/**/*.js src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:retention-integration": "vitest run test/retention-worker.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nutrition-tracker/artifact-store": "workspace:*",
    "@nutrition-tracker/contracts": "workspace:*",
    "@nutrition-tracker/db": "workspace:*",
    "@nutrition-tracker/domain": "workspace:*",
    "@nutrition-tracker/search": "workspace:*",
    "fastify": "5.12.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
