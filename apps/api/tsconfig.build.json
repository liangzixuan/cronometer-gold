{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "tsBuildInfoFile": "node_modules/.cache/api.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test/**/*.ts", "vitest.config.ts"]
}
